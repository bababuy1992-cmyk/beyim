# ===================================================
# Beyim AI Desktop Agent (Gemini Vision) Конфигурациясы
# ===================================================

# Google AI Studio API кілті (https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Vision моделі (gemini-2.5-flash, gemini-2.0-flash, gemini-2.5-pro, т.б.)
GEMINI_MODEL=gemini-2.5-flash

# Әр әрекетті растау режимі:
# true  - бағдарлама әр әрекет алдында сұрайды
# false - толық автоматты режим (ұсынылады)
CONFIRM_ACTIONS=false

# Қадамдар арасындағы кідіріс (секундпен)
STEP_DELAY=4.0

# Бір тапсырмаға берілетін максималды қадам саны
MAX_STEPS=200

# Әр қадамның скриншоттарын run_logs папкасына сақтау
SAVE_SCREENSHOTS=true

# Дыбысты жазу мүмкіндігі (микрофон және жүйелік дыбыс)
AUDIO_ENABLED=true
